{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkbox",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  // Created later via: wrangler d1 create checkbox  (then paste database_id here)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checkbox",
      "database_id": "9fd24f30-4050-49b3-8728-ba8a69b83c07",
      "migrations_dir": "migrations"
    }
  ],
  // Created later via: wrangler kv namespace create SESSIONS  (then paste id here)
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "9297e85a77544ebfb68bc57963df97a7" }
  ],
  // 15-min tick = calendar sync + watch renewal; 06:00 = morning brief (Phase 4)
  "triggers": { "crons": ["*/15 * * * *", "0 6 * * *"] },
  // Local dev base URL — override with the real workers.dev URL after deploy.
  "vars": {
    "WORKER_URL": "https://checkbox.tamara-sovcik.workers.dev"
  }
  // Secrets (set via `wrangler secret put` for prod; put in .dev.vars for local):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CALENDAR_ENCRYPTION_KEY
}
