{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkbox",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker BEFORE static assets for these routes. Without this,
    // Cloudflare's SPA not_found_handling serves index.html for any browser
    // navigation (Accept: text/html) that doesn't match a file — including
    // /api/auth/google — so the Worker's OAuth redirect never runs. API/MCP
    // fetches (Accept: application/json) were unaffected, which masked the bug.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },
  "observability": { "enabled": true },
  // Created later via: wrangler d1 create checkbox  (then paste database_id here)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checkbox",
      "database_id": "9fd24f30-4050-49b3-8728-ba8a69b83c07",
      "migrations_dir": "migrations"
    }
  ],
  // Created later via: wrangler kv namespace create SESSIONS  (then paste id here)
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "9297e85a77544ebfb68bc57963df97a7" }
  ],
  // R2 bucket for file attachments. Usage is capped in-app (see FREE_TIER_STORAGE_CAP
  // in routes/attachments.ts) well under R2's 10 GB free tier so it never bills.
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "checkbox-attachments" }
  ],
  // 15-min tick = calendar sync + watch renewal; 06:00 = morning brief (Phase 4)
  "triggers": { "crons": ["*/15 * * * *", "0 6 * * *"] },
  // Local dev base URL — override with the real workers.dev URL after deploy.
  "vars": {
    "WORKER_URL": "https://checkbox.tamara-sovcik.workers.dev"
  }
  // Secrets (set via `wrangler secret put` for prod; put in .dev.vars for local):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CALENDAR_ENCRYPTION_KEY
}
